---
// Language-neutral entry point: sends Spanish browsers to /es/…, everyone else to /en/….
// Used for the root URL and for the short URLs printed as QR codes.
import { href } from '../lib/url';

interface Props {
  path?: string;
  title: string;
}
const { path = '', title } = Astro.props;
const es = href(`es/${path}`);
const en = href(`en/${path}`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="en" href={en} />
    <script is:inline define:vars={{ es, en }}>
      var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
      var spanish = list.some(function (l) { return /^(es|ca|eu|gl)\b/i.test(l); });
      location.replace((spanish ? es : en) + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${es}`} /></noscript>
    <style>
      body { margin: 0; min-height: 100svh; display: grid; place-items: center; background: #0e0e0d; color: #ece9e3; font: 16px/1.5 system-ui, sans-serif; }
      a { color: inherit; margin: 0 12px; }
    </style>
  </head>
  <body>
    <p><a href={es} hreflang="es">Español</a><a href={en} hreflang="en">English</a></p>
  </body>
</html>
