---
import { href } from '../lib/url';

interface Props {
  shot: string;
  alt: string;
  eager?: boolean;
}
const { shot, alt, eager = false } = Astro.props;
---

<div class="phone">
  <img
    src={href(`shots/${shot}.webp`)}
    alt={alt}
    width="720"
    height="1693"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</div>
